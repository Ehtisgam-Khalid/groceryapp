rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // In a real app, we would look up the user's role in the 'users' collection.
      // For this app, we'll also hardcode the admin email provided.
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'ehtisham@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['user', 'admin', 'vendor'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'stock']) &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price > 0 &&
             data.category is string &&
             data.stock is number && data.stock >= 0;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'];
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'rating', 'comment']) &&
             data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) &&
                    isValidUser(incoming()) &&
                    (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'phone', 'loyaltyPoints']));
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(catId);
    }

    match /orders/{orderId} {
      allow get: if (isOwner(resource.data.userId) || isAdmin()) && isValidId(orderId);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if (isAdmin() || (isOwner(existing().userId) && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'paymentMethod']))) && isValidId(orderId);
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(vendorId);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isOwner(existing().userId) && isValidId(reviewId) && (request.method == 'DELETE' || isValidReview(incoming()));
    }

    match /notifications/{noteId} {
      allow get: if (isOwner(resource.data.userId) || isAdmin()) && isValidId(noteId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() && isValidId(noteId);
      allow update: if isOwner(existing().userId) && isValidId(noteId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(existing().userId) && isValidId(noteId);
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    match /pricingPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(planId);
    }
  }
}
